{
  "schema_version": 1,
  "description": "What the app asks a pet to show (docs/pets.md). A state cue plays one state with the playback shape given here; its default state is used unless the pet's catalog maps the cue in its \"cues\" section. A reaction cue plays a state drawn from the pool the catalog maps it to, and nothing when it maps none.",
  "cues": {
    "idle": { "kind": "state", "state": "idle", "mode": "loop", "after": "idle", "fixed": true },
    "waiting": { "kind": "state", "state": "idle", "mode": "loop", "after": "idle" },
    "thinking": { "kind": "state", "state": "thinking", "mode": "phased", "after": "idle" },
    "reading": { "kind": "state", "state": "reading", "mode": "phased", "after": "idle" },
    "working": { "kind": "state", "state": "working", "mode": "phased", "after": "idle" },
    "attention": { "kind": "state", "state": "needs_input", "mode": "phased", "after": "idle" },
    "exhausted": { "kind": "state", "state": "out_of_quota", "mode": "loop", "after": "idle" },
    "error": { "kind": "state", "state": "tool_error", "mode": "once", "after": "previous" },
    "turn-finished": { "kind": "state", "state": "turn_finished", "mode": "once", "after": "idle" },
    "inactive": { "kind": "state", "state": "sleeping", "mode": "phased", "after": "idle" },
    "nap": { "kind": "state", "state": "sleeping", "mode": "phased", "after": "idle" },
    "start": { "kind": "state", "state": "starting", "mode": "once", "after": "idle" },
    "quit": { "kind": "state", "state": "closing", "mode": "once", "after": "stop" },
    "annoyed": { "kind": "state", "state": "angry", "mode": "once", "after": "stop" },
    "quit-angry": { "kind": "state", "state": "closing_angry", "mode": "once", "after": "stop" },
    "drag": { "kind": "state", "state": "dragging", "mode": "phased", "after": "idle" },
    "celebrate": { "kind": "reaction" },
    "snack": { "kind": "reaction" },
    "milestone": { "kind": "reaction" },
    "long-turn": { "kind": "reaction" },
    "birthday": { "kind": "reaction" },
    "may20": { "kind": "reaction" },
    "friday-evening": { "kind": "reaction" },
    "late-night": { "kind": "reaction" },
    "monday": { "kind": "reaction" },
    "lunch": { "kind": "reaction" },
    "leave-work": { "kind": "reaction" },
    "sleep": { "kind": "reaction" },
    "konami": { "kind": "reaction" },
    "danger": { "kind": "reaction" },
    "eye-break": { "kind": "reaction" },
    "water": { "kind": "reaction" },
    "reminder-done": { "kind": "reaction" }
  }
}
