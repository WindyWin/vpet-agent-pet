{
  "manifest_version": 3,
  "name": "Agent Pet Download Tracker",
  "version": "0.1.0",
  "description": "Track Chrome downloads and let your desktop pet react.",
  "permissions": ["downloads", "nativeMessaging", "storage"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Agent Pet downloads"}
}
