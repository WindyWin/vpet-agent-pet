---
import Icon from './Icon.astro';
import Scene from './Scene.astro';
import type { Messages } from '../i18n';
interface Props { t: Messages; }
const { t } = Astro.props;
const f = t.features;
const docs = 'https://github.com/WindyWin/vpet-agent-pet/blob/main/starter/docs/';
const symbols = ['⌘', '♡', '✳', '✦'];
---
<section class="section features-section" id="features" aria-labelledby="features-title" data-feature-demo>
  <div class="container">
    <div class="section-heading centered" data-reveal>
      <p class="eyebrow">{f.eyebrow}</p><h2 id="features-title">{f.title}</h2><p class="lede">{f.text}</p>
    </div>
    <div class="feature-switch" role="group" aria-label={t.nav.features} data-reveal>
      {f.tabs.map((tab, i) => <button type="button" data-feature-choice={i} aria-pressed={i === 0}><span aria-hidden="true">{symbols[i]}</span>{tab}</button>)}
    </div>
    <div class="feature-desktop" data-feature-desktop data-mode="0" data-reveal>
      <div class="desktop-chrome"><span class="chrome-dots" aria-hidden="true">● ● ●</span><span>agent-pet / {f.tabs[0]}</span><span aria-hidden="true">✧</span></div>
      <div class="desktop-world">
        <div class="world-orbit" aria-hidden="true"></div><span class="world-spark" aria-hidden="true">✳</span>
        <div class="feature-window">
          <div data-feature-panel="0">
            <p class="window-caption">{f.terminalLabel}</p>
            <div class="work-terminal" role="group" aria-label={f.terminalLabel}>
              {['rg "hello" src/', 'git diff', 'npm test'].map((cmd, i) => <button type="button" data-feature-command={i} data-pose={i === 2 ? 'working' : 'reading'} data-message={f.commands[i]} aria-pressed={i === 0}><span aria-hidden="true">❯</span><code>{cmd}</code><span class="command-arrow" aria-hidden="true">↵</span></button>)}
              <p data-command-result aria-live="polite">{f.commands[0]}</p>
            </div>
          </div>
          <div data-feature-panel="1" hidden>
            <p class="window-caption">{f.chatLabel}<span class="beta-label">Beta</span></p>
            <div class="chat-question"><span class="chat-avatar" aria-hidden="true">✳</span><p>{f.prompt}</p></div>
            <div class="chat-answers">{f.answers.map((answer, i) => <button type="button" data-feature-answer data-message={i === 0 ? f.replyDetail : f.reply}>{answer}<span aria-hidden="true">↗</span></button>)}</div>
            <p class="chat-reply" data-feature-reply role="status" hidden></p>
            <button class="chat-reset" type="button" data-chat-reset hidden>{f.reset} ↺</button>
          </div>
          <div data-feature-panel="2" hidden>
            <p class="window-caption">{f.agentLabel}</p>
            <div class="agent-list" role="group" aria-label={f.agentLabel}>{['Claude Code', 'Codex', 'OpenCode', 'Antigravity'].map((name, i) => <button type="button" data-feature-agent={name} data-message={f.connected} aria-pressed={i === 0}><span class="agent-mark" aria-hidden="true">{['✳', '⌘', '›_', '↗'][i]}</span><strong>{name}</strong><span class="agent-dot" aria-hidden="true"></span></button>)}</div>
          </div>
          <div data-feature-panel="3" hidden>
            <div class="pack-ticket"><span class="ticket-stamp" aria-hidden="true">♡</span><p class="eyebrow">{f.packLabel}</p><h3>{f.packText}</h3><a class="button button-small" href="https://github.com/WindyWin/agent-pet-gallery">{f.gallery}<Icon name="arrow" size={16}/></a></div>
          </div>
        </div>
        <Scene class="feature-scene" label={f.scene} bubble={f.bubble} state="reading" copy={t.pet}><div class="feature-rug"></div></Scene>
      </div>
      <div class="desktop-foot"><span class="status-dot" aria-hidden="true"></span>{f.preview}</div>
    </div>
    <div class="feature-story">
      {f.items.map((item, i) => <div data-feature-story={i} hidden={i !== 0}><p class="eyebrow">{item.tag}</p><h3>{item.title}</h3><p>{item.text}</p><details><summary>{f.details}</summary><p>{item.detail}</p><a class="text-link" href={`${docs}${item.path}`}>{item.link} ↗</a></details></div>)}
    </div>
  </div>
</section>
<style>
  .features-section { overflow: hidden; background: linear-gradient(180deg, transparent, #eee8fa 50%, transparent); }
  .section-heading { max-width: 46rem; margin: 0 auto 2rem; }
  .feature-switch { display: flex; justify-content: center; gap: .5rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .feature-switch button { display: flex; align-items: center; gap: .65rem; border: 1px solid transparent; border-radius: 99px; background: transparent; padding: .8rem 1.2rem; font-weight: 800; color: var(--muted); cursor: pointer; }
  .feature-switch button span { font-size: 1.3rem; }
  .feature-switch button[aria-pressed=true] { background: var(--ink); color: white; box-shadow: 0 5px 0 #c9bfdf; }
  .feature-desktop { max-width: 1000px; margin: auto; border: 1px solid #d6cce9; border-radius: 24px; box-shadow: 0 24px 70px #52416b18; overflow: hidden; background: #faf8ff; }
  .desktop-chrome, .desktop-foot { display: flex; align-items: center; gap: 12px; padding: 15px 22px; font-size: .78rem; font-weight: 700; color: var(--muted); }
  .desktop-chrome { justify-content: space-between; border-bottom: 1px solid #ded5eb; }
  .chrome-dots { color: #aa91ce; letter-spacing: 3px; }
  .desktop-foot { justify-content: center; text-align: center; }
  .desktop-world { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; min-height: 390px; padding: 2rem; isolation: isolate; background: #e8e0f4; transition: background .3s; }
  [data-mode="1"] .desktop-world { background: #f5dfdf; } [data-mode="2"] .desktop-world { background: #dfeae2; } [data-mode="3"] .desktop-world { background: #f6e5cf; }
  .world-orbit { position: absolute; width: 440px; height: 440px; border: 1px solid #ffffff99; border-radius: 50%; right: -30px; top: -130px; z-index: -1; box-shadow: 0 0 0 50px #ffffff25, 0 0 0 100px #ffffff20; }
  .world-spark { position: absolute; right: 10%; top: 20px; color: var(--violet-dark); font-size: 3rem; }
  .feature-window { z-index: 2; background: #fffdfb; padding: 1.5rem; border-radius: 18px; box-shadow: 0 15px 0 -6px #6753851a, 0 20px 40px #67538512; transform: rotate(-2deg); }
  .window-caption { display: flex; justify-content: space-between; gap: 8px; font-size: .8rem; font-weight: 800; color: var(--muted); margin-bottom: 1.2rem; }
  .beta-label { color: var(--violet-dark); }
  .work-terminal { background: var(--terminal); padding: 1rem; border-radius: 10px; color: white; }
  .work-terminal button { display: flex; align-items: center; width: 100%; gap: .8rem; background: transparent; color: #dcd1ee; border: 0; padding: .8rem; border-radius: 6px; text-align: left; cursor: pointer; }
  .work-terminal button[aria-pressed=true] { background: #ffffff18; color: white; }
  .work-terminal button > span:first-child { color: #c1a1ff; }.command-arrow { margin-left: auto; }
  .work-terminal p { margin: 1rem .8rem .3rem; color: #d5c0f1; font-size: .8rem; min-height: 2.5em; }
  .chat-question { display: flex; gap: 12px; align-items: flex-start; font-size: 1.25rem; font-weight: 800; line-height: 1.45; }
  .chat-avatar { color: var(--violet); font-size: 1.8rem; }
  .chat-answers { display: grid; gap: .6rem; margin-top: 1.5rem; }
  .chat-answers button { display: flex; justify-content: space-between; gap: 12px; padding: .8rem 1rem; border-radius: 12px; background: #f0eafa; color: var(--violet-dark); border: 1px solid #d6c8eb; cursor: pointer; font-weight: 700; text-align: left; }
  .chat-answers button:disabled { opacity: .55; cursor: default; }
  .chat-reply { margin-top: 1rem; line-height: 1.6; color: var(--violet-dark); }.chat-reset { border: 0; background: none; color: var(--violet-dark); padding: .75rem 0 0; cursor: pointer; text-decoration: underline; }
  .agent-list { display: grid; gap: .5rem; }.agent-list button { display: flex; align-items: center; gap: 1rem; padding: .75rem; border: 1px solid transparent; border-radius: 12px; background: #f6f4f9; text-align: left; cursor: pointer; color: var(--ink); }.agent-list button[aria-pressed=true] { border-color: var(--violet); background: #ede6fa; }
  .agent-mark { font-size: 1.25rem; width: 28px; text-align: center; }.agent-dot { margin-left: auto; border-radius: 50%; width: 8px; height: 8px; background: #aaa; }[aria-pressed=true] .agent-dot { background: #52795b; }
  .pack-ticket { padding: .5rem; }.ticket-stamp { display: block; color: var(--violet-dark); font-size: 4rem; line-height: 1; margin-bottom: 1.5rem; }.pack-ticket h3 { font-size: 1.6rem; line-height: 1.35; margin: .75rem 0 1.5rem; }
  .feature-story { max-width: 680px; margin: 2.5rem auto 0; text-align: center; }.feature-story h3 { font-size: 1.7rem; margin: .5rem 0 .75rem; }.feature-story p:not(.eyebrow) { color: var(--muted); line-height: 1.7; }.feature-story details { margin-top: 1rem; font-size: .9rem; }.feature-story summary { cursor: pointer; color: var(--violet-dark); font-weight: 800; }.feature-story details p { margin: 1rem 0; }
  .features-section :global(.feature-scene) { height: 330px; --pet-size: 260px; overflow: visible; }
  .features-section :global(.feature-rug) { position: absolute; bottom: 10px; left: 5%; width: 90%; height: 55px; background: #bea6d180; border-radius: 50%; }
  @media (max-width: 700px) { .desktop-world { grid-template-columns: 1fr; padding: 1.5rem 1rem 0; }.feature-window { transform: none; padding: 1.2rem; }.features-section :global(.feature-scene) { height: 250px; --pet-size: 200px; }.world-spark { display: none; }.feature-switch button { padding: .6rem .8rem; font-size: .8rem; }.desktop-chrome { padding: 12px; font-size: .7rem; }.feature-story h3 { font-size: 1.4rem; } }
  :global(html:not(.js)) .features-section [data-feature-story][hidden] { display: block; margin-top: 2rem; }
  @media (prefers-reduced-motion: reduce) { .desktop-world { transition: none; } }
</style>
