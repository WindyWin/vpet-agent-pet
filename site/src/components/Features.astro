---
import Icon from './Icon.astro';
import type { Messages } from '../i18n';
interface Props { t: Messages; }
const { t } = Astro.props;
const docs = 'https://github.com/WindyWin/vpet-agent-pet/blob/main/starter/docs/';
---
<section class="section features-section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{t.features.eyebrow}</p>
      <h2 id="features-title">{t.features.title}</h2>
      <p class="lede">{t.features.text}</p>
    </div>
    <div class="features-grid">
      {t.features.items.map((item, index) => (
        <article class="feature-note" data-reveal>
          <div class="feature-top"><span class="feature-number" aria-hidden="true">0{index + 1}</span><span class="feature-tag">{item.tag}</span></div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <p class="feature-detail">{item.detail}</p>
          <a class="text-link" href={`${docs}${item.path}`}>{item.link}<Icon name="arrow" size={16}/></a>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .features-section { background: linear-gradient(180deg, transparent, var(--lilac), transparent); }
  .section-heading { max-width: 48rem; margin-bottom: 2.5rem; }
  .features-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .feature-note { display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.25rem, 3vw, 2.5rem); border: 1px solid rgba(112, 80, 213, .16); border-radius: 1.75rem; background: var(--bg); }
  .feature-note:nth-child(2) { background: #fff4ed; }
  .feature-note:nth-child(3) { background: #f0f5ef; }
  .feature-top { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .feature-number { font-size: 2rem; font-weight: 800; color: var(--violet-dark); }
  .feature-tag { font-size: .875rem; font-weight: 800; color: var(--violet-dark); }
  h3 { font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: 1.3; }
  p { color: var(--muted); line-height: 1.7; }
  .feature-detail { font-size: .9rem; border-top: 1px solid rgba(112, 80, 213, .16); padding-top: 1rem; }
  .text-link { margin-top: auto; align-self: flex-start; }
  @media (max-width: 700px) { .features-grid { grid-template-columns: 1fr; } }
</style>
