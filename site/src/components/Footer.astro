---
import Scene from './Scene.astro';
import Icon from './Icon.astro';
import type { Messages } from '../i18n';
interface Props { t: Messages; }
const { t } = Astro.props;
const repo = 'https://github.com/WindyWin/vpet-agent-pet';
---
<footer class="footer"><div class="container"><div class="footer-top"><div><a class="wordmark" href="#top"><span class="brand-flower" aria-hidden="true">✳</span>Agent Pet<span class="brand-period">.</span></a><p class="footer-tag">{t.footer.tag}</p><div class="footer-links"><a href={repo}><Icon name="github" size={16}/>{t.footer.source}</a><a href={`${repo}/releases/latest`}>{t.footer.releases}</a><a href={`${repo}/issues/new/choose`}>{t.footer.issues}</a></div></div><div class="footer-pet"><Scene class="footer-scene" label={t.footer.scene} state="sleeping" bubble={t.footer.bubble} copy={t.pet} /></div></div><div class="footer-bottom"><div><p>{t.footer.art} <a href="https://github.com/LorisYounger/VPet">LorisYounger/VPet</a> · <a href={`${repo}/blob/main/licenses/VPET-ARTWORK-TERMS.md`}>{t.footer.terms}</a>.</p><p><a href={`${repo}/blob/main/starter/LICENSE`}>{t.footer.code}</a></p><p>{t.footer.demo}</p></div><a class="back-top" href="#top" aria-label={t.footer.top}>↑</a></div></div></footer>
