---
import Icon from './Icon.astro';
import { localeUrl, type Locale, type Messages } from '../i18n';
interface Props { locale: Locale; t: Messages; }
const { locale, t } = Astro.props;
---
<header class="nav">
  <div class="container nav-inner">
    <a class="wordmark" href="#top"><span class="brand-flower" aria-hidden="true">✳</span> Agent Pet<span class="brand-period">.</span></a>
    <nav class="nav-links" aria-label={t.nav.sections}>
      <a href="#states">{t.nav.states}</a><a href="#features">{t.nav.features}</a><a href="#play">{t.nav.play}</a><a href="#care">{t.nav.care}</a><a class="nav-install-link" href="#install">{t.nav.install}</a>
    </nav>
    <div class="nav-tools">
      <div class="language-switch" role="group" aria-label={t.nav.language}>
        {(['en', 'vi'] as const).map(lang => <a href={localeUrl(lang)} lang={lang} hreflang={lang} aria-current={locale === lang ? 'page' : undefined} data-locale-link>{lang.toUpperCase()}</a>)}
      </div>
      <button class="motion-toggle" type="button" data-motion-toggle data-pause={t.nav.pause} data-resume={t.nav.resume} aria-label={t.nav.motion} aria-pressed="false"><span data-motion-icon aria-hidden="true">Ⅱ</span><span class="sr-only" data-motion-label>{t.nav.pause}</span></button>
      <a class="button button-small nav-download" href="#install">{t.nav.install}<Icon name="arrow" size={16} /></a>
    </div>
  </div>
</header>
