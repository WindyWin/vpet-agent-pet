---
import Scene from './Scene.astro';
import Icon from './Icon.astro';
import type { Messages } from '../i18n';
interface Props { t: Messages; }
const { t } = Astro.props;
---
<section class="hero section" id="top" aria-labelledby="hero-title">
  <div class="hero-orbit" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span class="tiny-flower" aria-hidden="true">✳</span> {t.hero.eyebrow}</p>
      <h1 id="hero-title">{t.hero.title.split('\n').map((line, i) => <><span class:list={{ 'title-soft': i === 1 }}>{line}</span>{i === 0 && <br />}</>)}</h1>
      <p class="lede">{t.hero.text}</p>
      <div class="hero-actions"><a class="button" href="#install">{t.hero.download}<Icon name="arrow" size={18} /></a><a class="text-link" href="#states">{t.hero.explore}<span aria-hidden="true">↘</span></a></div>
      <ul class="hero-facts"><li><Icon name="check" size={15} />{t.hero.free}</li><li><Icon name="shield" size={15} />{t.hero.local}</li></ul>
      <p class="platform-caption"><Icon name="linux" size={16} /><Icon name="apple" size={16} /><Icon name="windows" size={16} /><span>{t.hero.platforms}</span></p>
    </div>
    <div class="hero-visual" data-reveal>
      <div class="floating-label hero-badge"><span class="status-dot" aria-hidden="true"></span>{t.hero.badge}</div>
      <div class="desktop-window">
        <div class="window-bar"><div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div><span>{t.hero.project}</span><Icon name="spark" size={14} /></div>
        <div class="terminal" aria-label={t.hero.demo}><p class="terminal-path">~/projects/{t.hero.project}</p><p><span class="terminal-chevron">❯</span> {t.hero.task}</p><p class="terminal-live"><span class="terminal-spinner" aria-hidden="true">✳</span> {t.hero.log}</p><div class="terminal-lines" aria-hidden="true"><i></i><i></i><i></i></div></div>
        <Scene class="hero-scene" label={t.hero.demo} bubble={t.hero.bubble} hint={t.hero.hint} copy={t.pet} eager><span class="desktop-sun"></span><span class="desktop-floor"></span><span class="desk-plant"><i></i><i></i><i></i><b></b></span></Scene>
        <div class="desktop-status"><span class="status-dot" aria-hidden="true"></span>{t.hero.online}<span aria-hidden="true">♡</span></div>
      </div>
      <div class="hero-sticker"><Icon name="heart" size={18} /><span>{t.hero.sticker}</span></div>
      <span class="drawn-spark spark-one" aria-hidden="true">✧</span><span class="drawn-spark spark-two" aria-hidden="true">✳</span>
    </div>
  </div>
  <div class="hero-bottom container" aria-hidden="true"><span>Claude Code</span><span class="connection-line"></span><span class="little-heart">♡</span><span class="connection-line"></span><span>Codex</span></div>
</section>
